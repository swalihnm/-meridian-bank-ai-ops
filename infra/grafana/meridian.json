{
  "title": "Meridian assistant",
  "uid": "meridian-assistant",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Chat requests by route",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (route) (rate(meridian_chat_requests_total[5m]))", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Chat latency p95 (seconds)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(meridian_chat_latency_seconds_bucket[5m])))", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors per second",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 6},
      "targets": [{"expr": "rate(meridian_chat_errors_total[5m])", "refId": "A"}]
    }
  ]
}
